# =============================================================================
# DollarKoers — Payload CMS environment
# =============================================================================
# Copy to apps/payload/.env and fill in real values:
#   cp apps/payload/.env.example apps/payload/.env
#
# Never commit .env. Generate secrets with:
#   openssl rand -hex 32
#   openssl rand -base64 32
# =============================================================================

# --- Payload core --------------------------------------------------------------
# IMPORTANT: Do NOT reuse the placeholder. Generate a fresh secret per environment.
# Changing it invalidates all existing sessions.
PAYLOAD_SECRET=replace-with-output-of-openssl-rand-hex-32

# MUST exactly match the URL you type in the browser to reach the admin.
#   Local:       http://localhost:3000
#   Production:  https://cms.yourdomain.com
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: comma-separated extra origins for CORS + CSRF cookies
# (apex + www, or staging + prod).
# PAYLOAD_ALLOWED_ORIGINS=https://www.cms.yourdomain.com,https://staging.cms.yourdomain.com

# Optional: extra hosts allowed to open the Next.js auth/dev UI (comma-separated).
# PAYLOAD_ALLOWED_DEV_ORIGINS=49.13.135.140,cms.yourdomain.com

# Optional: force the auth cookie `Secure` flag.
#   Unset (default) → secure only when PAYLOAD_PUBLIC_SERVER_URL is https://
#   "false"         → never secure (plain HTTP only; private network / short tests)
#   "true"          → always secure
# PAYLOAD_COOKIE_SECURE=false

# Name shown in authenticator apps for 2FA (also hardcoded as issuer in payload.config).
PAYLOAD_TOTP_ISSUER=DollarKoers

# Debug logging (pm2 / docker stdout) while diagnosing saves/deletes.
# PAYLOAD_DEBUG_API=1
# PAYLOAD_DEBUG_AUTH=1

# Optional — stabilizes admin Save/Delete across `next build` + PM2 restarts.
# MUST be base64 (Next.js runs atob() then AES-GCM). Decoded length = 16, 24, or 32 bytes.
#   CORRECT:  openssl rand -base64 32
#   WRONG:    openssl rand -hex 32  (→ "Invalid key length" on /admin)
# Set BEFORE `pnpm build`, then: rm -rf .next && pnpm build && pm2 restart
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- Postgres ------------------------------------------------------------------
# Neon serverless recommended in production.
DATABASE_URI=postgres://payload:payload@localhost:5432/dollarkoers

# --- Cloudflare R2 (media) -----------------------------------------------------
# 1. Create bucket (e.g. dollarkoers-media)
# 2. Enable public access (R2.dev subdomain or custom domain)
# 3. Create R2 API token (Object Read & Write on this bucket)
# 4. Set R2_PUBLIC_URL to the PUBLIC URL (not the S3 API endpoint)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dollarkoers-media
R2_PUBLIC_URL=https://media.example.com

# --- Cloudflare Workers (tenant deploys) ---------------------------------------
# Fallback when a tenant has no linked Cloudflare credential in Payload admin.
# Prefer storing credentials under Platform → Cloudflare credentials.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Optional: account workers.dev subdomain (e.g. "my-account") used to build
# https://<slug>.<subdomain>.workers.dev when wrangler output cannot be parsed.
# CLOUDFLARE_WORKERS_DEV_SUBDOMAIN=

# --- Webhook (Payload → CI) ----------------------------------------------------
WEBHOOK_URL=https://webhook.example.com/payload
WEBHOOK_TOKEN=replace-with-shared-secret

# --- GitHub (workflows + Tenant admin buttons) ---------------------------------
# Token permissions: actions:write, contents:write, pull_requests:write
# Easiest: fine-grained PAT scoped to this repo.
GITHUB_TOKEN=
GITHUB_OWNER=YOUR_ORG
GITHUB_REPO=dollarkoers
# Branch the workflows run on. Defaults to "main" if omitted.
GITHUB_BRANCH=main

# Optional: PAT for external client-repo checkout when a tenant has no linked
# GitHub credential. Falls back to GITHUB_TOKEN.
# EXTERNAL_REPO_GITHUB_TOKEN=

# Encrypt GitHub credentials stored in Payload (github-credentials collection).
# Generate: openssl rand -base64 32
# Falls back to DEPLOY_REPORT_TOKEN / PAYLOAD_SECRET if unset (not recommended).
# CREDENTIALS_ENCRYPTION_KEY=

# Shared secret for GitHub Actions / Jenkins → report-deploy, import-blog-content,
# /api/ci/github-token, /api/ci/cloudflare-credentials, etc.
# Must match the CI secret DEPLOY_REPORT_TOKEN exactly.
# Also authorizes REST reads on tenants / blog-posts / media via
# header x-deploy-report-token. Generate: openssl rand -hex 32
DEPLOY_REPORT_TOKEN=replace-with-output-of-openssl-rand-hex-32

# --- CI provider ---------------------------------------------------------------
# Admin can also set this under Globals → Platform settings. Env is the fallback.
# CI_PROVIDER=github_actions
# CI_PROVIDER=jenkins

# Jenkins (when CI_PROVIDER=jenkins or Platform settings → Jenkins)
# JENKINS_URL=https://jenkins.example.com
# JENKINS_USER=dollarkoers-ci
# JENKINS_API_TOKEN=
# JENKINS_JOB_DEPLOY=tenant-deploy
# JENKINS_JOB_IMPORT=tenant-import-blog
# JENKINS_JOB_SETUP=tenant-repo-setup
# JENKINS_JOB_SCAFFOLD=tenant-scaffold

# --- Scripts that call Payload over HTTP (CI helpers) --------------------------
# Used by report:deploy, import:blog-from-repo-api, scheduled-publish, etc.
# PAYLOAD_URL=http://localhost:3000
# PAYLOAD_API_KEY=

# Per-user API keys (Payload admin → Users → Enable API Key) are used as the
# GitHub/Jenkins secret PAYLOAD_API_KEY for tenant-cli sync and blog pulls.
